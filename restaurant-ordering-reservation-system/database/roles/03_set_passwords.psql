-- 03_set_passwords.psql   (MESA-INC2: the login roles are created WITHOUT a password by 01_create_roles.sql)
-- Run as postgres. Every prompt is hidden; nothing is saved to disk, shell history or the repository.
--   psql -h localhost -U postgres -d postgres -f database/roles/03_set_passwords.psql
-- Afterwards put the application password in your local .env (DB_PASSWORD=...). Never commit .env.

\echo 'Password for rors_app    (the PHP application login)'
\password rors_app
\echo 'Password for rors_report (read-only / auditor login)'
\password rors_report
\echo 'Password for rors_maint  (maintenance login)'
\password rors_maint
\echo 'Password for rors_backup (backup login)'
\password rors_backup
\echo 'Password for rors_dba    (administrator login)'
\password rors_dba
