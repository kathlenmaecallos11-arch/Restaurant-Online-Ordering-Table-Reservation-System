# Copy this file to .env and edit the values. .env is local only and is never committed.
# Placeholders only: no real passwords belong in this file.

APP_NAME="Restaurant Online Ordering & Table Reservation System"
APP_BRAND=Mesa
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila

DB_HOST=localhost
DB_PORT=5432
DB_NAME=grp_binarysisters_projectdb
# Application account created by database/setup.ps1 -WithRoles (least privilege).
# For a quick local look only, you may use postgres, but not for real use.
DB_USER=rors_app
DB_PASSWORD=CHANGE_ME
# Use "require" on a hosted database
DB_SSLMODE=prefer