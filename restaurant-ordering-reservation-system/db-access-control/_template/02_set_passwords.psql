-- 02_set_passwords.psql  -- hidden prompts; nothing is saved to disk, history or the repository.
--   psql -h localhost -U postgres -d postgres -v prefix=g03 -f 02_set_passwords.psql
\set login_app    :prefix _app
\set login_report :prefix _report
\set login_maint  :prefix _maint
\set login_backup :prefix _backup

\echo 'Password for the application runtime login'
\password :login_app
\echo 'Password for the read-only / auditor login'
\password :login_report
\echo 'Password for the maintenance login'
\password :login_maint
\echo 'Password for the backup login'
\password :login_backup
